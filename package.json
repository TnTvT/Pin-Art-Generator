{
  "name": "pin-art-generator",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@pin-art/web",
    "dev:api": "turbo run dev --filter=@pin-art/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=@pin-art/web",
    "test:api": "turbo run test --filter=@pin-art/api"
  },
  "devDependencies": {
    "turbo": "2.11.5"
  }
}
